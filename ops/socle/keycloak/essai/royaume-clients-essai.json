{
  "ifResourceExists": "OVERWRITE",
  "clients": [
    {
      "clientId": "essai-direct",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": ["basic", "profile"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience-api-clients",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "api-clients", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "roles-portail",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": { "usermodel.clientRoleMapping.clientId": "portail", "claim.name": "roles_portail", "jsonType.label": "String", "multivalued": "true", "access.token.claim": "true", "id.token.claim": "true", "introspection.token.claim": "true" }
        },
        {
          "name": "organisations",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": { "claim.name": "organisations", "full.path": "true", "access.token.claim": "true", "id.token.claim": "true", "introspection.token.claim": "true" }
        }
      ]
    }
  ]
}

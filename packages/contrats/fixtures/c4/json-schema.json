        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      },
      "automatisationId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      },
      "moduleCode": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,62}$"
      },
      "moduleVersion": {
        "type": "string",
        "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
      },
      "reglages": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "dureeCacheSecondes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 86400
      }
    },
    "required": [
      "instanceId",
      "clientId",
      "automatisationId",
      "moduleCode",
      "moduleVersion",
      "reglages",
      "dureeCacheSecondes"
    ],

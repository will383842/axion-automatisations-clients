{
  "version": "0.2.1",
  "routes": {
    "configuration": {
      "methode": "GET",
      "chemin": "/api/executeur/v1/instances/{instanceId}/configuration",
      "limite": "c4",
      "antiDoublon": "lecture"
    },
    "etatVoulu": {
      "methode": "GET",
      "chemin": "/api/executeur/v1/instances/{instanceId}/etat-voulu",
      "limite": "c4",
      "antiDoublon": "lecture"
    },
    "evenements": {
      "methode": "POST",
      "chemin": "/api/executeur/v1/evenements",
      "limite": "c4",
      "antiDoublon": "execution"
    }
  },
  "configuration": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "instanceId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      },
      "clientId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      },
      "automatisationId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      },
      "moduleCode": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,62}$"
      },
      "moduleVersion": {
        "type": "string",
        "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
      },
      "reglages": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "dureeCacheSecondes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 86400
      }
    },
    "required": [
      "instanceId",
      "clientId",
      "automatisationId",
      "moduleCode",
      "moduleVersion",
      "reglages",
      "dureeCacheSecondes"
    ],
    "additionalProperties": false,
    "$defs": {
      "__schema0": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          },
          {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          }
        ]
      }
    }
  },
  "etatVoulu": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "instanceId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      },
      "etat": {
        "type": "string",
        "enum": [
          "actif",
          "pause",
          "arrete"
        ]
      },
      "arretEnvois": {
        "type": "boolean"
      },
      "version": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "instanceId",
      "etat",
      "arretEnvois",
      "version"
    ],
    "additionalProperties": false
  },
  "paquet": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "evenements": {
        "minItems": 1,
        "maxItems": 500,
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "debut"
                },
                "instanceId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "executionId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "a": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                }
              },
              "required": [
                "type",
                "instanceId",
                "executionId",
                "a"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "fin"
                },
                "instanceId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "executionId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "dureeMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "elements": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "minutesGagnees": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "jetons": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "coutIaMicroCentimes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "type",
                "instanceId",
                "executionId",
                "dureeMs",
                "elements",
                "minutesGagnees",
                "jetons",
                "coutIaMicroCentimes"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "erreur"
                },
                "instanceId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "executionId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "classe": {
                  "type": "string",
                  "enum": [
                    "passagere",
                    "quota",
                    "identification",
                    "definitive"
                  ]
                },
                "code": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{2,63}$"
                }
              },
              "required": [
                "type",
                "instanceId",
                "executionId",
                "classe",
                "code"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "a_trancher"
                },
                "instanceId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "executionId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "etape": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "code": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{2,63}$"
                }
              },
              "required": [
                "type",
                "instanceId",
                "executionId",
                "etape",
                "code"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "signal_de_vie"
                },
                "instanceId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "celluleId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "a": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                }
              },
              "required": [
                "type",
                "instanceId",
                "celluleId",
                "a"
              ],
              "additionalProperties": false
            }
          ]
        }
      }
    },
    "required": [
      "evenements"
    ],
    "additionalProperties": false
  }
}

{
  "name": "axion-automatisations-clients",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "verifier": "pnpm -r typecheck && pnpm lint && pnpm test",
    "creer-module": "tsx packages/create-axion-module/src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "test": "vitest run",
    "test:compter": "vitest run --reporter=json --outputFile=rapport-tests.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "js-yaml": "4.3.2",
    "libpg-query": "17.8.1",
    "typescript": "^5.6.0",
    "tsx": "4.23.15",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
